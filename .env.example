# ──────────────────────────────────────────────────────────────────────
# Digital Khata App — Environment Variables
# Copy this file to `.env` and fill in real values.
# ──────────────────────────────────────────────────────────────────────

# Database (Supabase Postgres via connection pooler)
# Get this from: Supabase Dashboard → Connect → ORMs → Prisma
# The pooler URL is REQUIRED for Vercel (direct connection is blocked)
DATABASE_URL=postgresql://postgres.ywmddhvenvrcgihodmdg:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct URL for Prisma migrations (session-mode pooler)
DIRECT_URL=postgresql://postgres.ywmddhvenvrcgihodmdg:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Owner PIN auth — generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Bcrypt rounds for PIN hashing (10 = ~100ms)
BCRYPT_ROUNDS=10

# Session lifetime in seconds (default 24 hours)
SESSION_TTL_SECONDS=86400
