# ──────────────────────────────────────────────────────────────────────
# Digital Khata App — Environment Variables
# Copy this file to `.env` and fill in real values.
# ──────────────────────────────────────────────────────────────────────

# Database (Supabase Postgres)
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# IMPORTANT: URL-encode special characters in the password:
#   $ → %24, @ → %40, : → %3A, / → %2F, space → %20
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Owner PIN auth — generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Bcrypt rounds for PIN hashing (10 = ~100ms)
BCRYPT_ROUNDS=10

# Session lifetime in seconds (default 24 hours)
SESSION_TTL_SECONDS=86400
