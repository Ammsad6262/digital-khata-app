# ──────────────────────────────────────────────────────────────────────
# Digital Khata App — Environment Variables
# Copy this file to `.env` and fill in real values.
# ──────────────────────────────────────────────────────────────────────

# Database (SQLite for V1). The path is relative to the project root.
# The DB file is created automatically by `prisma migrate dev`.
DATABASE_URL="file:./prisma/dev.db"

# App
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Owner PIN auth
# A random 32+ char string used to sign the session cookie.
# Generate one with: `openssl rand -base64 32`
SESSION_SECRET="change-me-to-a-long-random-string"

# Bcrypt rounds for PIN hashing (10 = ~100ms, secure enough for V1)
BCRYPT_ROUNDS="10"

# Session lifetime in seconds (default 24 hours)
SESSION_TTL_SECONDS="86400"
