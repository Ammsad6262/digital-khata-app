# ──────────────────────────────────────────────────────────────────────
# Digital Khata App — Environment Variables
# Copy this file to `.env` and fill in real values.
# ──────────────────────────────────────────────────────────────────────

# Database (Supabase Postgres via connection pooler)
# Get this from: Supabase Dashboard → Connect → ORMs → Prisma
# The pooler URL is REQUIRED for Vercel (direct connection is blocked)
DATABASE_URL=postgresql://postgres.ywmddhvenvrcgihodmdg:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct URL for Prisma migrations (session-mode pooler)
DIRECT_URL=postgresql://postgres.ywmddhvenvrcgihodmdg:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# App
# NOTE: do NOT set NODE_ENV here. Next.js sets it per command (development for
# `next dev`, production for `next build`). A NODE_ENV=development line in .env
# used to leak into `next build` and break the production prerender.
APP_URL=http://localhost:3000

# Owner PIN auth — generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Admin secret for /admin/codes and password-reset code issuance.
# Must be at least 16 characters. Generate with: openssl rand -base64 32
ADMIN_SECRET=change-me-to-a-long-random-admin-secret

# Bcrypt rounds for PIN hashing (10 = ~100ms)
BCRYPT_ROUNDS=10

# Session lifetime in seconds (default 24 hours)
SESSION_TTL_SECONDS=86400

# Google Gemini API key — enables the AI assistant, smart entry and the
# Urdu/Pashto voice understanding. Get one at https://aistudio.google.com/apikey
# Without it the assistant still handles common English/Roman-Urdu commands via
# the deterministic rules, but Urdu/Pashto commands need the model.
GEMINI_API_KEY=

# Optional: override the three-model free-tier rotation (one each).
# GEMINI_MODEL_1=gemini-3.5-flash
# GEMINI_MODEL_2=gemini-3.1-flash-lite
# GEMINI_MODEL_3=gemini-3-flash-preview
# GEMINI_DAILY_LIMIT=20
