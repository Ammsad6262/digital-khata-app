{
  "name": "digital-khata-app",
  "version": "0.3.0",
  "private": true,
  "description": "Digital Khata & Wholesale Business Management App",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/apply-production-ddl.mjs && next build --experimental-build-mode compile",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx scripts/seed-sample-data.ts",
    "test:foundation": "tsx scripts/test-foundation.ts",
    "test:charts": "tsx scripts/test-charts.ts",
    "audit:i18n": "tsx scripts/check-i18n.ts",
    "audit:rtl": "node scripts/rtl-audit.mjs",
    "audit:routes": "node scripts/audit-routes.mjs",
    "audit:security": "node scripts/audit-security-static.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "test:security": "tsx scripts/test-security.ts",
    "test:audit": "tsx scripts/audit-data-integrity.ts",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "test:acceptance": "tsx scripts/test-acceptance-http.ts",
    "test:assistant": "tsx scripts/test-assistant.ts",
    "test:voice": "tsx scripts/test-voice-assistant.ts",
    "test:khata": "tsx scripts/test-khata-assistant.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.62.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "lucide-react": "^0.468.0",
    "next": "^16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
