// ────────────────────────────────────────────────────────────────────────────
// Digital Khata & Wholesale Business App — Prisma Schema (V1)
// Phase 2 — Database / Data Architecture
// ────────────────────────────────────────────────────────────────────────────
//
// Design principles:
//
// 1. Money is always Decimal(12, 2) — Postgres-native decimal type.
//    Never Float. Stored as NUMERIC in Postgres — exact precision, no rounding.
// 2. Quantities are Decimal(10, 3) — wholesale sells by kg, box, dozen.
//    (Restored Postgres-native @db.Decimal types — SQLite couldn't support them
//    so we dropped them in Phase 3. Now we have proper column-level precision.)
// 3. Customer balance is DERIVED, never manually edited:
//      openingBalance
//    + SUM(sale.totalAmount)        [credit sales increase balance]
//    - SUM(payment.amount)          [payments decrease balance]
//    + SUM(adjustment.amount)      [signed: + owes more, - owes less]
//    = current balance
//
// 4. Product stock is DERIVED, never manually edited:
//      openingStock
//    + SUM(stockMove.quantity)     [signed: purchases +, adjustments ±, returns +]
//    - SUM(saleItem.quantity)      [items sold via sales]
//    = current stock
//
// 5. `Transaction` is a denormalized unified ledger — one row per financial
//    movement (sale, payment, expense, stock move, adjustment). Written in the
//    same prisma.$transaction as the source-of-truth table. Makes the
//    "Transaction History" feed a single-table query.
//
// 6. Multi-table mutations (e.g. recording a sale = Sale + SaleItems + Payment
//    + StockMoves-not-needed + Transaction rows) are wrapped in
//    prisma.$transaction. If any step fails, all roll back.
//
// 7. Voiding is preferred over deleting. Sales and Payments have `voidedAt`.
//    Voided records are excluded from balance/stock calculations but kept
//    for audit.
// ────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl is used for migrations (pgbouncer pooler doesn't support
  // prepared-statement-based DDL operations, so we bypass it for migrations).
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// CUSTOMER
// ────────────────────────────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String   @unique
  address        String?
  notes          String?

  // Opening balance — set ONCE when the customer is migrated from paper khata
  // to the app. Represents the outstanding amount the customer already owed
  // before any digital transactions were recorded. Default 0 for new customers.
  openingBalance Decimal @db.Decimal(12, 2)    @default(0)

  isDeleted      Boolean  @default(false) // soft-delete flag (used in V2; V1 blocks hard delete)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales       Sale[]
  payments    Payment[]
  adjustments CustomerAdjustment[]
  transactions Transaction[]

  @@index([name])
  @@index([phone])
}

// ────────────────────────────────────────────────────────────────────────────
// PRODUCT
// ────────────────────────────────────────────────────────────────────────────

model Product {
  id        String  @id @default(cuid())
  name      String
  category  String?

  purchasePrice Decimal   // cost price (for future profit reports)
  sellingPrice  Decimal   // default selling price
  unit          String  @default("piece") // piece, kg, box, dozen, etc.
  sku           String? @unique           // optional product code

  // Opening stock — set ONCE when the product is migrated from paper register.
  // Represents the stock count at the moment the product was added to the app.
  // Default 0 for new products added after go-live.
  openingStock   Decimal @db.Decimal(12, 2)   @default(0)

  lowStockThreshold Int   @default(5)
  isDeleted         Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  saleItems SaleItem[]
  stockMoves StockMove[]
  transactions Transaction[]

  @@index([name])
  @@index([category])
  @@index([sku])
}

// ────────────────────────────────────────────────────────────────────────────
// SALE  (one invoice — can contain multiple products)
// ────────────────────────────────────────────────────────────────────────────

model Sale {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Total of all SaleItem.total — denormalized for fast display
  totalAmount Decimal
  // Money received at sale time (may be 0 for pure credit sale)
  paidAmount  Decimal @db.Decimal(12, 2)    @default(0)
  // totalAmount - paidAmount (denormalized; source of truth is the calculation)
  outstanding Decimal

  notes      String?
  date       DateTime @default(now()) // can be backdated
  voidedAt   DateTime? // null = active; set when voided
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items    SaleItem[]
  payments Payment[] // payments linked specifically to this sale

  @@index([customerId])
  @@index([date])
  @@index([voidedAt])
}

// ────────────────────────────────────────────────────────────────────────────
// SALE ITEM  (one line in a sale — Sale → SaleItems is one-to-many)
// ────────────────────────────────────────────────────────────────────────────

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Decimal
  unitPrice Decimal   // price per unit at time of sale (snapshot)
  total     Decimal   // quantity * unitPrice (denormalized)

  // ── Batch tracking (added 2026-09) ────────────────────────────────────────
  // Links this sale line to the specific purchase batch it was sold from.
  // NULL = "legacy / untracked" — sales recorded before batch tracking shipped,
  // OR sales from "opening stock" (which is not a StockMove batch).
  //
  // When this SaleItem is created, the linked StockMove.remainingQuantity is
  // decremented by `quantity`. When the sale is voided, it's restored.
  stockMoveId String?
  stockMove   StockMove? @relation(fields: [stockMoveId], references: [id])
  // ─────────────────────────────────────────────────────────────────────────

  @@index([saleId])
  @@index([productId])
  @@index([stockMoveId])
}

// ────────────────────────────────────────────────────────────────────────────
// PAYMENT  (money received from a customer — decreases their balance)
// ────────────────────────────────────────────────────────────────────────────

model Payment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Optional link to a specific Sale — useful when payment is for one invoice
  saleId     String?
  sale       Sale?    @relation(fields: [saleId], references: [id])

  amount     Decimal
  method     String   // "cash" | "bank" | "cheque" | "jazzcash" | "easypaisa" | "other"
  notes      String?
  date       DateTime @default(now())
  voidedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@index([saleId])
  @@index([date])
}

// ────────────────────────────────────────────────────────────────────────────
// CUSTOMER ADJUSTMENT  (manual correction to a customer's balance — signed)
// ────────────────────────────────────────────────────────────────────────────
//
// Use cases:
//   - Migrating from paper khata and realizing the opening balance was wrong
//   - Writing off bad debt (negative adjustment)
//   - Correcting a data entry error from a voided-but-misrecorded sale
//
// amount is SIGNED:
//   +X means customer now owes X more (debit)
//   -X means customer now owes X less (credit)
// ────────────────────────────────────────────────────────────────────────────

model CustomerAdjustment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  amount     Decimal   // signed: + increases balance, - decreases
  reason     String   // required — must explain why the adjustment was made
  notes      String?
  date       DateTime @default(now())
  voidedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@index([date])
}

// ────────────────────────────────────────────────────────────────────────────
// STOCK MOVE  (any intentional stock change by the owner — signed)
// ────────────────────────────────────────────────────────────────────────────
//
// type:
//   "purchase"   → quantity > 0 (bought from supplier)
//   "adjustment" → quantity signed (recount, write-off, correction)
//   "return"     → quantity > 0 (customer returned goods back to stock)
//
// Note: stock sold via a Sale is tracked in SaleItem, NOT in StockMove.
// The getProductStock() formula subtracts SUM(saleItem.quantity) separately.
// ────────────────────────────────────────────────────────────────────────────

model StockMove {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  type      String   // "purchase" | "adjustment" | "return"
  quantity  Decimal   // signed
  reason    String?
  unitCost  Decimal?  // optional purchase cost (for V2 profit reports)

  // ── Batch tracking (added 2026-09) ────────────────────────────────────────
  // How much of THIS batch is still in stock. Decremented when a SaleItem
  // links to this StockMove; restored if that sale is voided.
  //
  // For type="purchase": represents remaining units from this purchase.
  // For type="adjustment" / "return": NOT used for batch tracking (remainingQuantity = 0).
  // For type="opening" (synthetic batch created on product creation, if we add it later):
  //   same semantics as "purchase".
  //
  // Default 0 — migration backfills = quantity for existing purchases.
  remainingQuantity Decimal @db.Decimal(12, 2) @default(0)
  // ─────────────────────────────────────────────────────────────────────────

  date      DateTime @default(now())
  voidedAt  DateTime?
  createdAt DateTime @default(now())

  // SaleItems linked to this batch (one StockMove → many SaleItems over time,
  // because a single purchase can be sold off across many separate sales).
  saleItems SaleItem[]

  @@index([productId])
  @@index([type])
  @@index([date])
}

// ────────────────────────────────────────────────────────────────────────────
// EXPENSE  (business expense — does NOT affect any customer's balance)
// ────────────────────────────────────────────────────────────────────────────

model Expense {
  id        String   @id @default(cuid())
  name      String
  amount    Decimal
  category  String   // "transport" | "shop" | "electricity" | "packaging" | "salary" | "rent" | "other"
  notes     String?
  date      DateTime @default(now())
  voidedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([date])
}

// ────────────────────────────────────────────────────────────────────────────
// TRANSACTION  (denormalized unified ledger — one row per financial movement)
// ────────────────────────────────────────────────────────────────────────────
//
// Purpose:
//   - Powers the "Transaction History" screen with a single-table query.
//   - Provides a flat audit log of every money movement in the business.
//
// Source of truth for balances/stock = specialized tables (Sale, Payment, etc.).
// This table is a denormalized mirror — kept in sync via prisma.$transaction.
//
// type:
//   "sale"               — a sale was recorded (direction "debit"  on customer)
//   "payment"            — a payment was received (direction "credit" on customer)
//   "expense"            — an expense was recorded (no customer/product link)
//   "stock_move"         — stock was added/adjusted/returned (productId set)
//   "balance_adjustment" — customer balance was manually adjusted
//
// amount is always positive; `direction` tells you which way it moves the
// customer balance or stock. For expenses, direction is "debit" (reduces
// business cash) but no customer is linked.
// ────────────────────────────────────────────────────────────────────────────

model Transaction {
  id         String   @id @default(cuid())
  type       String   // "sale" | "payment" | "expense" | "stock_move" | "balance_adjustment"
  refId      String   // ID of the source record (Sale.id, Payment.id, etc.)
  refType    String   // "Sale" | "Payment" | "Expense" | "StockMove" | "CustomerAdjustment"

  customerId String?  // set if transaction involves a customer
  customer   Customer? @relation(fields: [customerId], references: [id])

  productId  String?  // set if transaction involves a product (stock moves)
  product    Product?  @relation(fields: [productId], references: [id])

  amount     Decimal   // always positive; direction tells you sign
  direction  String   // "debit" | "credit" — semantic per type, see docs
  date       DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([customerId])
  @@index([productId])
  @@index([date])
  @@index([refType, refId])
}

// ────────────────────────────────────────────────────────────────────────────
// SETTING  (singleton — only one row, id = "singleton")
// ────────────────────────────────────────────────────────────────────────────

model Setting {
  id              String  @id @default("singleton")
  businessName    String?
  currency        String  @default("PKR")     // ISO 4217 code
  currencySymbol  String  @default("Rs.")
  ownerPinHash    String?                     // bcrypt hash of owner's PIN
  timezone        String  @default("Asia/Karachi")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
